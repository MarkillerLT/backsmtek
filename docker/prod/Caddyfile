{
	frankenphp
	# TLS and certificates are handled by the edge proxy (docker/proxy/Caddyfile).
	# This server is only reachable by Anubis over the internal Docker network.
	auto_https off
}

http://:8080 {
	root * /app/public
	encode zstd br gzip

	@build path /build/*
	header @build Cache-Control "public, max-age=31536000, immutable"

	php_server
}
