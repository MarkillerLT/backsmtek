{
	frankenphp
}

# SERVER_NAME=tudominio.com  -> HTTPS automático con Let's Encrypt
# SERVER_NAME=:80            -> solo HTTP (p. ej. detrás de otro proxy o Cloudflare)
{$SERVER_NAME:localhost} {
	root * /app/public
	encode zstd br gzip

	# Cache largo para los assets compilados por Vite (llevan hash en el nombre)
	@build path /build/*
	header @build Cache-Control "public, max-age=31536000, immutable"

	php_server
}
