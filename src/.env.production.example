
APP_NAME=SMTEK
APP_ENV=production
APP_DEBUG=false
# base64: + output of: openssl rand -base64 32
APP_KEY=
APP_URL=https://example.com
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_TIMEZONE=America/Mexico_City

# Use ":80" when a proxy in front (e.g. Cloudflare) already terminates HTTPS
SERVER_NAME=example.com

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=smtek
DB_USERNAME=smtek
# openssl rand -hex 24
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=SMTEK
