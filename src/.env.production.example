
APP_NAME=SMTEK
APP_ENV=production
APP_DEBUG=false
# base64: + output of: openssl rand -base64 32
APP_KEY=
APP_URL=https://example.com
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_TIMEZONE=America/Mexico_City

# Domain served by the edge Caddy (service "proxy"), which gets the TLS certificates.
# Use ":80" when a proxy in front (e.g. Cloudflare) already terminates HTTPS
SERVER_NAME=example.com

# --- Anubis (anti-bot layer between Caddy and Laravel) ---
# Keeps visitors' Anubis cookies valid across restarts/deploys (secret).
# Generate with: openssl rand -hex 32   (empty = random key on every start)
ANUBIS_ED25519_PRIVATE_KEY_HEX=
# Domains Anubis may redirect to after a challenge (default: SERVER_NAME).
# Comma-separated, e.g. example.com,www.example.com
#ANUBIS_REDIRECT_DOMAINS=
# Shown on the "access denied" page so blocked users can ask for help
#ANUBIS_WEBMASTER_EMAIL=
#ANUBIS_DIFFICULTY=4
#ANUBIS_LOG_LEVEL=INFO
# Subnet of the internal anubis<->app network, trusted by Laravel for
# X-Forwarded-*. Change only if it overlaps with a network on the server.
#ANUBIS_BACKEND_SUBNET=10.201.53.0/24

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=smtek
DB_USERNAME=smtek
# openssl rand -hex 24
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=SMTEK
