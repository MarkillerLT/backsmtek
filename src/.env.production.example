
APP_NAME=SMTEK
APP_ENV=production
APP_DEBUG=false
# Genérala con: bin/prod run --rm --no-deps app php artisan key:generate --show
APP_KEY=
APP_URL=https://tudominio.com
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_TIMEZONE=America/Mexico_City

# Dominio para Caddy/FrankenPHP (HTTPS automático).
# Usa ":80" si hay otro proxy o Cloudflare delante que ya hace el HTTPS.
SERVER_NAME=tudominio.com

# Logs a la salida del contenedor (se ven con: bin/prod logs -f app)
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=smtek
DB_USERNAME=smtek
# Usa contraseñas largas y aleatorias:  openssl rand -base64 32
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@tudominio.com
MAIL_FROM_NAME=SMTEK
